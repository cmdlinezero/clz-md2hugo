[0,"o","\u001b[2m┌─ TermCast MCP: MD2HUGO ─┐\u001b[0m\r\n"]
[0,"o","\r\nTermCast MCP: Markdown to animated GIF\r\n"]
[0.7,"o","\r\nThis demonstration uses the ./mcp-term executable from the repository root, plus python3 and agg installed on PATH. Run from the repository root. The demo uses the termcast-demo/ directory; remove or rename an existing directory before repeating the demo. Import executes commands, so review the lab first.\r\n"]
[0.4, "o", "$ "]
[1.1, "o", "echo \"GENERATE: $SITE\"\r\n"]
[1.3, "o", "GENERATE: my-site\r\n"]
[1.8, "o", "$ "]
[2.4, "o", "# Generate certin content\r\n"]
[2.6, "o", "$ "]
[3.2, "o", "./clz-md2hugo build \\\r\n"]
[3.6, "o", "   -i examples/${SITE} \\\r\n"]
[4.0, "o", "   -o examples/generated/content.json\r\n"]
[5.2, "o", "Wrote examples/generated/content.json\r\n"]
[5.6, "o", "$ "]
[6.2, "o", "# Generate catalogue\r\n"]
[6.4, "o", "# Use: `--include-unpublished` includes: Published + draft + review + archived\r\n"]
[6.6, "o", "$ "]
[7.2, "o", "./clz-md2hugo project \\\r\n"]
[7.6, "o", "  --input examples/${SITE} \\\r\n"]
[8.0, "o", "  --catalogue examples/generated/catalogue.json \\\r\n"]
[8.4, "o", "  --payload-dir examples/generated/private/payloads\r\n"]
[9.8, "o", "Wrote examples/generated/catalogue.json and payloads to examples/generated/private/payloads\r\n"]
[10.2, "o", "$ "]
[10.8, "o", "# Copy updated content to destination\r\n"]
[11.0, "o", "$ "]
[11.6, "o", "cp examples/generated/content.json ../clz-certin/assets/data\r\n"]
[12.0, "o", "$ "]
[12.5, "o", "cp examples/generated/catalogue.json ../clz-certin/assets/data\r\n"]
[13.0, "o", "$ "]
[13.5, "o", "cp examples/generated/private/payloads/public.json ../clz-certin/assets/data\r\n"]
[14.2, "o", "$ "]
